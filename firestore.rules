rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────
    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isAdmin() {
      return isLoggedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.admin == true;
    }

    // ── Users ───────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isLoggedIn() && isOwner(userId);
      allow list: if isAdmin();
      allow create: if isLoggedIn() && isOwner(userId);
      allow update: if isLoggedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Tryouts ─────────────────────────────────────────────────────
    // read = public (landing page tidak perlu login untuk lihat katalog)
    // detail soal tetap aman karena ada di subcollection terpisah
    match /tryouts/{tryoutId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── User Tryouts (kepemilikan & progress) ────────────────────────
    match /user_tryouts/{docId} {
      allow read: if isLoggedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isLoggedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Exam Results ────────────────────────────────────────────────
    match /exam_results/{resultId} {
      allow read: if isLoggedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Exam Types (kategori ujian) ──────────────────────────────────
    // read = public agar landing page bisa pakai data ini jika diperlukan
    match /exam_types/{typeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Purchases ───────────────────────────────────────────────────
    match /purchases/{purchaseId} {
      allow read: if isLoggedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}