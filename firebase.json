{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "lulusasn-e15a3",
          "appId": "1:975581006036:android:d8ece2f8bfbb002b22d341",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "lulusasn-e15a3",
          "configurations": {
            "android": "1:975581006036:android:d8ece2f8bfbb002b22d341",
            "ios": "1:975581006036:ios:52af5ad81184069a22d341",
            "macos": "1:975581006036:ios:52af5ad81184069a22d341",
            "web": "1:975581006036:web:aa0e63f164359fb622d341",
            "windows": "1:975581006036:web:bf70b4360f747d7b22d341"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast2",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
